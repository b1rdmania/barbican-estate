#!/bin/sh
# Usage: ./flat barbican                 fetch every agency, rebuild, deploy
#        ./flat <frankharris id or url>  fetch one Frank Harris listing, rebuild, deploy
# Agencies: Frank Harris (fetch.mjs), Nicola Lee, Thomas Michael, Base (fetchers/).
set -e
cd "$(dirname "$0")"
node fetch.mjs "$@"
if [ "$1" = barbican ]; then
  for f in fetchers/*.mjs; do node "$f" || echo "warning: $f failed, keeping its old data"; done
fi
node build.mjs
GODEBUG=netdns=go npx wrangler deploy   # Cloudflare Worker barbican-estate -> https://barbican.estate/
